        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение плана тренировки сбросит текущий таймер. Вы уверены?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el plan reiniciará el temporizador actual. ¿Seguro?"
          }
        }
